{
  "name": "nebula",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel --filter server --filter web dev",
    "start": "pnpm -r --parallel --filter server --filter web start",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter server test",
    "surfpool:install": "node scripts/surfpool.mjs install",
    "surfpool": "node scripts/surfpool.mjs"
  },
  "packageManager": "pnpm@10.23.0"
}

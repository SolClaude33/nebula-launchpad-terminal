{
  "name": "nebula",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "pnpm -r --parallel --filter server --filter web start",
    "mainnet": "node scripts/mainnet.mjs",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter server test",
    "surfpool:install": "node scripts/surfpool.mjs install",
    "surfpool": "node scripts/surfpool.mjs",
    "test:chain": "pnpm --filter server test:chain",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "packageManager": "pnpm@10.23.0",
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1"
  }
}
